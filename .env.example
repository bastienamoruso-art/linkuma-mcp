# Linkuma API key (required) — get one at https://app.linkuma.com/
LINKUMA_API_KEY=lkm_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Hard budget cap enforced before any POST /carts/order (EUR). Default: 500.
LINKUMA_BUDGET_CAP_EUR=500

# Client-side rate limit (requests per second). Default: 2.
LINKUMA_RATE_LIMIT_RPS=2

# Below this threshold linkuma_doctor flags low_credit_warning=true. Default: 50.
LINKUMA_LOW_CREDIT_THRESHOLD_EUR=50

# Local idempotency store directory. Default: ~/.linkuma-mcp
LINKUMA_IDEMPOTENCY_DIR=

# Optional: override base URL (mostly for tests).
LINKUMA_BASE_URL=https://app.linkuma.com/api/v1
